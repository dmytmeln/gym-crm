<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="GIA-87-training-table-create" author="Dmytro Melnyk">
        <createTable tableName="training">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="training_PK"/>
            </column>
            <column name="trainee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="trainer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="training_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="training_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="training_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="training_duration" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="training"
                                 baseColumnNames="trainee_id"
                                 referencedTableName="trainee"
                                 referencedColumnNames="id"
                                 constraintName="training_trainee_FK"/>
        <addForeignKeyConstraint baseTableName="training"
                                 baseColumnNames="trainer_id"
                                 referencedTableName="trainer"
                                 referencedColumnNames="id"
                                 constraintName="training_trainer_FK"/>
        <addForeignKeyConstraint baseTableName="training"
                                 baseColumnNames="training_type_id"
                                 referencedTableName="training_type"
                                 referencedColumnNames="id"
                                 constraintName="training_training_type_FK"/>
    </changeSet>

</databaseChangeLog>
