<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="GIA-87-trainee-trainer-table-create" author="Dmytro Melnyk">
        <createTable tableName="trainee_trainer">
            <column name="trainee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="trainer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="trainee_trainer"
                       columnNames="trainee_id,trainer_id"
                       constraintName="trainee_trainer_PK"/>
        <addForeignKeyConstraint baseTableName="trainee_trainer"
                                 baseColumnNames="trainee_id"
                                 referencedTableName="trainee"
                                 referencedColumnNames="id"
                                 constraintName="trainee_trainer_trainee_FK"/>
        <addForeignKeyConstraint baseTableName="trainee_trainer"
                                 baseColumnNames="trainer_id"
                                 referencedTableName="trainer"
                                 referencedColumnNames="id"
                                 constraintName="trainee_trainer_trainer_FK"/>
    </changeSet>

</databaseChangeLog>
