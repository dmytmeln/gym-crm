<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="GIA-87-training-type-table-create" author="Dmytro Melnyk">
        <createTable tableName="training_type">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="training_type_PK"/>
            </column>
            <column name="training_type_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="training_type"
                             columnNames="training_type_name"
                             constraintName="training_type_training_type_name_UQ"/>
    </changeSet>

</databaseChangeLog>
