<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="GIA-87-trainer-table-create" author="Dmytro Melnyk">
        <createTable tableName="trainer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="trainer_PK"/>
            </column>
            <column name="specialization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="trainer"
                                 baseColumnNames="user_id"
                                 referencedTableName="user"
                                 referencedColumnNames="id"
                                 constraintName="trainer_user_FK"/>
        <addForeignKeyConstraint baseTableName="trainer"
                                 baseColumnNames="specialization_id"
                                 referencedTableName="training_type"
                                 referencedColumnNames="id"
                                 constraintName="trainer_training_type_FK"/>
    </changeSet>

</databaseChangeLog>
